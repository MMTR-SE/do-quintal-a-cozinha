# Copie este arquivo para .env na mesma pasta e preencha:
#   cp docker/quart/.env.example docker/quart/.env

# Obrigatórias para o bot iniciar (ele valida as duas no boot)
OPENAI_API_KEY=
GIPHY_API_KEY=

# Caminhos internos (padrões ok — persistidos no volume quart_data)
AUTH_DIR=./data/auth/
DATABASE_PATH=./data/chat_history.db
