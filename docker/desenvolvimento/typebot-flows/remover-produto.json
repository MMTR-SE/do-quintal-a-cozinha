              "richText": [
                {
                  "type": "p",
                  "children": [
                    {
                      "text": "📦 Esses são os seus produtos cadastrados até agora:"
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "in44c1sgjn5knf6xv6ea43pu",
            "type": "Code",
            "options": {
              "content": "const nomes = {{productArrayNames}}; // Ex: [\"Bolo de Cenoura\", \"Bolo de Fubá\"]\nconst descricoes = {{productArrayDescription}}; // Ex: [\"Delicioso...\", \"Feito com carinho...\"]\n\nconst listaFormatada = nomes\n  .map((nome, i) => `✨ *${i + 1}*: ${nome}\\n📝 _${descricoes[i]}_`)\n  .join(\"\\n\\n\");\n\nsetVariable(\"listaFormatada\", listaFormatada);\nsetVariable(\"nomesProdutos\", nomes);",
              "isExecutedOnClient": false
            }
          },
          {
            "id": "i6bf0lltqnygn3czittws1cq",
            "type": "text",
            "content": {
              "richText": [
                {
                  "type": "p",
                  "children": [
                    {
                      "text": "{{listaFormatada}}"
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "mysunjkdsmhblozbgz3ntyj8",
            "type": "text",
            "content": {
              "richText": [
                {
                  "type": "p",
                  "children": [
                    {
                      "text": "Digite o número do produto que você quer remover, tá bom? 😊"
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "phaj0uyqbfe7ky86ps4ljr3t",
            "type": "text input",
            "options": {
              "isLong": false,
              "variableId": "lbt5jmds0f391t1c46dqkiti"
            }
          },
          {
            "id": "gogw82xghpqwd4elu4ptfmjd",
            "type": "Code",
            "options": {
              "content": "const nomes = {{nomesProdutos}};\nconst ids = {{productArrayId}};\nconst input = parseInt({{escolhaProduto}});\nconst index = input - 1;\n\nif (isNaN(input) || index < 0 || index >= nomes.length) {\n  setVariable(\"produtoEscolhido\", null);\n  setVariable(\"produtoIdEscolhido\", null);\n} else {\n  setVariable(\"produtoEscolhido\", nomes[index]);\n  setVariable(\"produtoIdEscolhido\", ids[index]);\n}\n",
              "isExecutedOnClient": false
            }
          },
          {
            "id": "dkzv3i99hfohjc7mdziaeeb7",
            "type": "Condition",
            "items": [
