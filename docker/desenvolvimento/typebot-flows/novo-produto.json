            "id": "yzm2meyzgx9ej2d2qfr55v21",
            "type": "Code",
            "options": {
              "content": "// value received from Typebot variable\nconst price = {{price}};\n\n// Function to parse price formats like: R$25,90 / 25,9 / 25.900,50 / 25\nfunction parseToDecimal(value) {\n  if (!value) return null;\n\n  return Number(\n    value\n      .toString()\n      .replace(/[R$\\s]/gi, \"\") // remove R$, $\n      .replace(/\\./g, \"\")      // remove thousand separators\n      .replace(\",\", \".\")       // convert decimal comma to dot\n  );\n}\n\n// Parse and store in Typebot variable\nconst parsedPrice = parseToDecimal(price);\n\nsetVariable(\"parsedPrice\", parsedPrice);\n",
              "isExecutedOnClient": false
            }
          },
