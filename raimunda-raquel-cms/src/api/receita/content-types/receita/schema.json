{
  "kind": "collectionType",
  "collectionName": "receitas",
  "info": {
    "singularName": "receita",
    "pluralName": "receitas",
    "displayName": "Nossas Receitas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "preparation_time_in_minutes": {
      "type": "integer",
      "required": true
    },
    "cooking_time_in_minutes": {
      "type": "integer",
      "required": true
    },
    "number_of_servings": {
      "type": "integer",
      "required": true
    },
    "difficulty": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Fácil",
        "Média",
        "Díficil"
      ]
    },
    "ingredients": {
      "type": "json",
      "required": true
    },
    "steps": {
      "type": "component",
      "component": "receita.passo",
      "repeatable": true
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "author_name": {
      "type": "string"
    }
  }
}
