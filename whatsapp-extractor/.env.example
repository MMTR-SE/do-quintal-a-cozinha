# Copie para .env na mesma pasta e preencha:
#   cp .env.example .env

# Grupo a escutar (use um dos dois; sem ambos, captura todos os grupos)
GROUP_NAME=
# GROUP_ID=5531999999999-1234567890@g.us

# Groq (grátis em https://console.groq.com) — necessária para transcrever áudios
# e para o `npm run knowledge`
GROQ_API_KEY=

# Modelos (opcional — padrões funcionam; liste os disponíveis via
# GET https://api.groq.com/openai/v1/models com a chave)
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Opcional: capturar também as mensagens do próprio número pareado
# INCLUDE_SELF=1
