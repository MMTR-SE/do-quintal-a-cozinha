# PostgreSQL connection string
# Development: postgres service from docker/desenvolvimento/docker-compose.yml
DATABASE_URL=postgresql://quintal:quintal@localhost:5432/quintal?schema=public

# Production/Docker: use the postgres service hostname (compose network)
# DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DB?schema=public

# PostgreSQL (docker compose services)
# Em produção (docker/producao/docker-compose.yml) ESTE arquivo é a única fonte:
# ele alimenta o site e o container quintal-postgres. Ou seja, o DATABASE_URL
# precisa apontar para o host `postgres` e a senha precisa ser a mesma de
# POSTGRES_PASSWORD.
POSTGRES_USER=quintal
POSTGRES_PASSWORD=quintal
POSTGRES_DB=quintal
TZ=America/Maceio

# AI Services - Groq API for audio transcription
GROQ_API_KEY=gsk_your_key_here

# API Authentication
API_KEY=your_api_key_here

# Strapi CMS
NEXT_PUBLIC_STRAPI_URL=https://conteudos.mulheresrurais.com.br
STRAPI_API_TOKEN=your_strapi_token_here

# Sincronização CMS <-> site (Postgres).
# O site NÃO lê o CMS em runtime: essas variáveis servem para o CMS avisar o
# site (POST /api/cms-sync) e para o site espelhar o que o Typebot cria.
# Leitura do CMS (CMS -> site). Defaults: NEXT_PUBLIC_STRAPI_URL / STRAPI_API_TOKEN
CMS_SYNC_URL=https://conteudos.mulheresrurais.com.br
CMS_SYNC_TOKEN=your_strapi_token_here
# Escrita no CMS (site -> CMS). Defaults: NEXT_PUBLIC_STRAPI_URL / STRAPI_API_TOKEN
CMS_API_URL=https://conteudos.mulheresrurais.com.br
CMS_API_TOKEN=your_strapi_token_here
# No container do CMS: endereço do site e chave de API dele (o middleware do
# site exige o header API_KEY em /api/cms-sync).
SITE_SYNC_URL=http://quintal:3000
SITE_SYNC_API_KEY=your_api_key_here

# Strapi secrets (required when running the CMS with Docker)
CMS_APP_KEYS=replace-with-two-random-comma-separated-values
CMS_API_TOKEN_SALT=replace-with-a-random-value
CMS_ADMIN_JWT_SECRET=replace-with-a-random-value
CMS_TRANSFER_TOKEN_SALT=replace-with-a-random-value
CMS_JWT_SECRET=replace-with-a-random-value
CMS_ENCRYPTION_KEY=replace-with-a-random-value

# Docker Environment Variables
PRODUCTION_APP=aplicacao-pwa
UX_APP=testando-ux
DEV_PATH=${PWD}
# Caminho do checkout na VPS de produção (usado pelo compose e pelo deploy).
PROD_PATH=/var/www/mulheresrurais.com.br

# Typebot (docker/desenvolvimento — builder em :3002, viewer em :3003)
TYPEBOT_NEXTAUTH_URL=http://localhost:3002
TYPEBOT_VIEWER_URL=http://localhost:3003
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TYPEBOT_ENCRYPTION_SECRET=replace-with-a-random-32-char-string

# Typebot + CMS da pré-produção (docker/pre-producao/docker-compose.yml).
# ENCRYPTION_SECRET: o Typebot exige exatamente 32 caracteres; o workflow de
# pré-produção gera este valor sozinho no $DEV_PATH/.env, não precisa preencher.
# ENCRYPTION_SECRET=32-caracteres
# Opcionais: dão plano ilimitado ao primeiro usuário e fecham o cadastro.
# ADMIN_EMAIL=alguem@exemplo.org
# DISABLE_SIGNUP=true
# Senha da caixa de entrada do Mailpit
# (https://typebot-dev.mulheresrurais.com.br/mailpit); o workflow também gera.
MAILPIT_USER=quintal
MAILPIT_PASSWORD=replace-with-a-random-value
