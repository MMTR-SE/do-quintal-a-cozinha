    "slug": { "type": "uid", "targetField": "nome", "required": true },
    "conteudo": { "type": "richtext" },
    "regiao": { "type": "string" },
    "imagem": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    }
  }
}
