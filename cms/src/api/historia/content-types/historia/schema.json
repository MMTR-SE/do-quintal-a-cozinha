{
  "kind": "collectionType",
  "collectionName": "historias",
  "info": {
    "singularName": "historia",
    "pluralName": "historias",
    "displayName": "História",
    "description": "Histórias das mulheres e dos territórios"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "titulo": { "type": "string", "required": true },
